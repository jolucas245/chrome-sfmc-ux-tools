{
    "manifest_version": 3,
    "name": "SFMC UX Tools",
    "version": "1.0.0",
    "description": "Usability helpers for Salesforce Marketing Cloud Engagement and Next: code editor help, readable keys, transactional messages.",
    "minimum_chrome_version": "122",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["storage", "scripting"],
    "host_permissions": ["https://*.marketingcloudapps.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "SFMC UX Tools: options",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "options.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "web_accessible_resources": [
        {
            "resources": ["icons/icon16.png"],
            "matches": [
                "https://*.exacttarget.com/*",
                "https://*.marketingcloudapps.com/*",
                "https://*.lightning.force.com/*"
            ]
        },
        {
            "resources": ["icons/sidebar-hide.svg", "icons/sidebar-show.svg"],
            "matches": ["https://*.exacttarget.com/*"]
        },
        {
            "resources": [
                "editor-codemirror.js",
                "language-data.js",
                "editor-highlight.js",
                "editor-language.js",
                "editor-format.js"
            ],
            "matches": ["https://*.exacttarget.com/*"]
        }
    ],
    "content_scripts": [
        {
            "matches": ["https://*.exacttarget.com/Content/Administration/InstalledPackages.aspx*"],
            "js": ["content.js"],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": [
                "language-data.js",
                "editor-highlight.js",
                "editor-language.js",
                "editor-format.js"
            ],
            "css": ["editor-highlight.css"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": [
                "editor-context-menu.js",
                "editor-theme.js",
                "editor-format-setting.js",
                "editor-typescript-loader.js",
                "editor-file-kind.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.lightning.force.com/cmsAuthor/contentEditor.app*"],
            "js": ["editor-language.js", "editor-format.js"],
            "css": ["editor-highlight.css"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/AutomationStudioFuel3/*"],
            "js": [
                "language-data.js",
                "editor-highlight.js",
                "editor-language.js",
                "editor-format.js"
            ],
            "css": ["editor-highlight.css"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/AutomationStudioFuel3/*"],
            "js": [
                "editor-context-menu.js",
                "editor-theme.js",
                "editor-format-setting.js",
                "editor-typescript-loader.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://*.marketingcloudapps.com/AutomationStudioFuel3/*",
                "https://*.marketingcloudapps.com/contactsmeta/*",
                "https://*.exacttarget.com/C12/Default.aspx*",
                "https://*.exacttarget.com/Content/Interactions/TriggeredSendConfiguration.aspx*",
                "https://*.exacttarget.com/Content/Administration/SendManagement/*",
                "https://*.exacttarget.com/Content/Administration/Roles/RoleDetails.aspx*",
                "https://*.exacttarget.com/Content/Administration/EmployeeDetails.aspx*"
            ],
            "js": ["key-rule.js", "readable-keys.js", "user-autofill.js"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": ["key-rule.js", "readable-keys.js", "journey-settings.js"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": ["key-rule-page.js", "content-builder.js"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.exacttarget.com/cloud/*"],
            "include_globs": ["https://mc.*"],
            "js": [
                "key-rule.js",
                "editor-theme.js",
                "editor-format-setting.js",
                "transactional-messages.js"
            ],
            "css": ["editor-codemirror.css", "editor-highlight.css", "transactional-messages.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.exacttarget.com/cloud/*"],
            "include_globs": ["https://mc.*"],
            "js": ["deep-link-shell.js"],
            "css": ["deep-link.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": ["deep-link-content-builder.js"],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.exacttarget.com/C12/Default.aspx*"],
            "js": ["deep-link-email-studio.js"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.exacttarget.com/C12/Default.aspx*"],
            "js": ["deep-link-email-studio-page.js"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.exacttarget.com/C12/Default.aspx*"],
            "js": ["email-studio-left-nav.js"],
            "css": ["email-studio-left-nav.css"],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.exacttarget.com/C12/Default.aspx*"],
            "js": ["email-studio-de-switcher.js"],
            "css": ["email-studio-de-switcher.css"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.exacttarget.com/cloud/*"],
            "include_globs": ["https://mc.*"],
            "js": ["email-studio-de-switcher-shell.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/contactsmeta/*"],
            "js": ["deep-link-contact-builder.js"],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/contactsmeta/*"],
            "js": ["record-search-rule.js", "record-search.js"],
            "css": ["record-search.css"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://*.marketingcloudapps.com/MobileConnectFuel3/*",
                "https://*.marketingcloudapps.com/mobileconnectfuel3/*",
                "https://*.marketingcloudapps.com/Mobile/*",
                "https://*.marketingcloudapps.com/mobile/*",
                "https://*.marketingcloudapps.com/mobilepush/*"
            ],
            "js": ["mobile-delete.js"],
            "css": ["mobile-delete.css"],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://jbinteractions.*"],
            "js": ["journey-settings.js"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://jbinteractions.*"],
            "js": ["key-rule.js", "journey-builder.js"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_start"
        }
    ]
}
